        def Material "GrainMaterial"
        {
            token outputs:surface.connect = </Asset/Floor/GrainMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Asset/Floor/GrainMaterial/Texture.outputs:rgb>
