#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["MaterialBindingAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    rel material:binding:physics = </Asset/Materials/Contact>
    float physics:mass = 1.4

    def "Materials"
    {
        def Material "steel"
        {
