                float inputs:metallic = 0.05
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "fan_blade"
        {
            token outputs:surface.connect = </Asset/Materials/fan_blade/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.048, 0.054, 0.063)
                float inputs:metallic = 0.35
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </Asset/Materials/copper/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.48, 0.23, 0.085)
