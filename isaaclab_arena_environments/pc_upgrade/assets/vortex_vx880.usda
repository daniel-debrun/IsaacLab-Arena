#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 1.4

    def "Materials"
    {
        def Material "steel"
        {
            token outputs:surface.connect = </Asset/Materials/steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.31, 0.35)
                float inputs:metallic = 0.85
                float inputs:roughness = 0.26
                token outputs:surface
            }
        }

