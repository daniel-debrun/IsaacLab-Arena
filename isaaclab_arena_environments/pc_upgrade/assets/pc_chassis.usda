        def Cube "HandleCollision" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI"]
        )
        {
            rel material:binding = </Asset/Materials/silver>
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.014, 0.012, 0.092)
            double3 xformOp:translate = (0.408, -0.03, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "Brand"
        {
            float3 xformOp:rotateXYZ = (90, 0, 0)
            double3 xformOp:translate = (0.223, -0.0041, -0.171)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

            def Mesh "Decal" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform bool doubleSided = 1
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                rel material:binding = </Asset/Panel/Brand/DecalMaterial>
                point3f[] points = [(-0.133, -0.0165, 0), (0.133, -0.0165, 0), (0.133, 0.0165, 0), (-0.133, 0.0165, 0)]
                texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                    interpolation = "vertex"
                )
                uniform token subdivisionScheme = "none"
            }

            def Material "DecalMaterial"
            {
                token outputs:surface.connect = </Asset/Panel/Brand/DecalMaterial/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </Asset/Panel/Brand/DecalMaterial/Texture.outputs:rgb>
                    float inputs:roughness = 0.5
                    token outputs:surface
                }

                def Shader "UV"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Texture"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @pc_label.png@
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Asset/Panel/Brand/DecalMaterial/UV.outputs:result>
                    color3f outputs:rgb
                }
            }
        }
    }

    def PhysicsRevoluteJoint "panel_hinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.8
        float drive:angular:physics:stiffness = 0
        uniform token physics:axis = "Z"
        rel physics:body0 = </Asset/Base>
        rel physics:body1 = </Asset/Panel>
        point3f physics:localPos0 = (-0.223, -0.132, 0.24)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -110
        float physics:upperLimit = 0
    }
}
