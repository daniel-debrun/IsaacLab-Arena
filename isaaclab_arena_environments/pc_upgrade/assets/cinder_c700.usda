    {
        token outputs:surface.connect = </Asset/TopBrand_cinder_c700Material/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Asset/TopBrand_cinder_c700Material/Texture.outputs:rgb>
